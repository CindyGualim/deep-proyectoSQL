# Los binarios no pasan por conversion de fin de linea: git los corromperia.
*.pdf binary
*.png binary
*.jpg binary
*.xz binary
*.safetensors binary
*.bin binary

# Texto, siempre con LF en el repositorio.
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.ipynb text eol=lf
